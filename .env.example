# AwaazOps environment — copy to .env.local and fill in. Never commit real values.
# All keys below are read server-side only (src/server/env.ts). Only NEXT_PUBLIC_* reach the browser.

# Provider selection: "mock" (SIMULATED, default) or the real provider.
AWAAZ_STT_PROVIDER=mock        # mock | gnani-prisma
AWAAZ_TTS_PROVIDER=mock        # mock | gnani-timbre
AWAAZ_LLM_PROVIDER=mock        # mock | llm

# Gnani — PROVISIONAL names, to be confirmed against official docs before use.
GNANI_API_KEY=
GNANI_PRISMA_BASE_URL=
GNANI_TIMBRE_BASE_URL=

# LLM reasoning (provider TBD)
LLM_API_KEY=
LLM_MODEL=

# Supabase (step 8). The anon key is public by design; the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
