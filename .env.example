# AwaazOps environment — copy to .env.local and fill in. Never commit real values.
# All keys below are read server-side only (src/server/env.ts). Only NEXT_PUBLIC_* reach the browser.

# Speech: Gnani Prisma v2.5 (speech-to-text) and Timbre v2.5 (voice) are the primary integrations.
# "mock" is a clearly-labelled SIMULATED stand-in for development without a Gnani key.
AWAAZ_STT_PROVIDER=gnani-prisma   # gnani-prisma | mock
AWAAZ_TTS_PROVIDER=gnani-timbre   # gnani-timbre | mock

# Gnani Vachana API (verified against docs.gnani.ai on 2026-11-06).
# One key for all Gnani APIs, sent as the X-API-Key-ID header. Get one via speechstack@gnani.ai.
GNANI_API_KEY=
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v2.5    # prisma-v2.5 | prisma-v3.0
GNANI_STT_FORMAT=transcribe    # transcribe (spoken numbers → digits) | verbatim

# Reasoning: deterministic rules engine by default — no API key, no paid service.
# Optionally add an LLM; if it is unavailable, fails or times out, the rules engine answers instead.
AWAAZ_REASONING_PROVIDER=rules # rules | claude
AWAAZ_REASONING_FALLBACK=rules # rules | none   (only used when an LLM is selected)
# Optional — only for AWAAZ_REASONING_PROVIDER=claude:
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low                 # low | medium | high | xhigh | max
LLM_TIMEOUT_MS=15000

# Data backend: memory (demo store, no sign-in) | supabase (Postgres + Auth + Storage; sign-in required).
AWAAZ_DATA_BACKEND=memory
# The anon key is public by design (RLS protects data); the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string, used only by `npm run db:migrate`.
SUPABASE_DB_URL=
